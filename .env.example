# 博客项目配置 - 使用 SQLite 存储博客文章

# App Configuration
VITE_APP_ID=personal-blog

# Server Configuration
PORT=3000               # 服务端口（可选，默认 3000）
# NODE_ENV 由启动脚本自动设置（development / production），无需手动配置

# Database Configuration - SQLite
DATABASE_URL=file:./blog.db

# Analytics Configuration (可选)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Admin Configuration (修改为你自己的账号密码)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=  # 使用 pnpm hash-password 你的密码 生成
JWT_SECRET=           # 使用 pnpm gen-secret 生成
