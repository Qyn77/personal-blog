# 博客项目配置 - 使用 SQLite 存储博客文章

# App Configuration
VITE_APP_ID=personal-blog

# Database Configuration - SQLite
DATABASE_URL=file:./blog.db

# Analytics Configuration (可选)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Admin Configuration (修改为你自己的账号密码)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=  # 使用 node -e "console.log(require('bcryptjs').hashSync('你的密码', 10))" 生成
JWT_SECRET=           # 使用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成
