# 博客项目配置 - 使用 SQLite 存储博客文章

# App Configuration
VITE_APP_ID=personal-blog

# Server Configuration
PORT=3000               # 服务端口（可选，默认 3000）
# NODE_ENV 由启动脚本自动设置（development / production），无需手动配置

# Database Configuration - SQLite
DATABASE_URL=file:./blog.db

# Analytics Configuration (可选)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# CDN Configuration (可选开关)
# 填入 CDN 域名即启用：图片/字体等静态资源走 CDN；留空则关闭，全部同源访问。
# 仅作用于静态资源，API 始终直连主域名。
# VITE_CDN_URL=https://cdn.example.com
VITE_CDN_URL=

# Admin Configuration (修改为你自己的账号密码)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=  # 使用 pnpm hash-password 你的密码 生成
JWT_SECRET=           # 使用 pnpm gen-secret 生成

# 邮箱服务配置（用于订阅功能）
EMAIL_SERVICE_HOST=smtp.qq.com
EMAIL_SERVICE_PORT=465
EMAIL_SERVICE_USER=your-email@qq.com
EMAIL_SERVICE_PASSWORD=your-smtp-password

# AI 功能配置（用于文章元数据生成和内容润色）
ENABLE_AI_FEATURES=true
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
